datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

model User {
  id String @id @default(uuid())

  email String  @unique
  name  String?

  hashedPassword      String    @default("")
  salt                String    @default("")
  resetToken          String?
  resetTokenExpiresAt DateTime?

  roles String @default("guest")

  defaultEntityId Int?
  defaultEntity   Entity? @relation("defaultEntity", fields: [defaultEntityId], references: [id])

  defaultRetailerEntityId Int?
  defaultRetailerEntity   Entity? @relation("defaultRetailerEntity", fields: [defaultRetailerEntityId], references: [id])

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  rates         Rate[]
  billableItems BillableItem[]
  estimates     Estimate[]
  entities      Entity[]
}

// enum UnitDimension {
//   LINEAR
//   SQUARE
//   CUBIC
//   VOLUME
//   TEMPORAL
//   COUNT
//   AREA
//   CUSTOM
// }

model MeasurementUnit {
  id Int @id @default(autoincrement())

  fullName    String // square foot - Full name of the unit of measurement.
  pluralName  String // square feet - Full plural name of the unit of measurement.
  shortName   String? // sqft - Abbreviated name of the unit of measurement.
  symbol      String? // ft² - Symbolic notation used for the unit of measurement.
  notation    String? // ' - Notation used for the unit (e.g., feet is ' and inches is ").
  description String? // Square feet is a unit of area measurement. - Detailed description of the unit.

  // dimension        UnitDimension // Dimension of the unit (e.g., linear, square, cubic).
  // conversionFactor Float? // 0.092903 - Factor for converting to a standard unit.
  // baseUnit         String? // meter - The base unit of measurement related to this unit.

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  rates         Rate[]
  billableItems BillableItem[]
}

model Action {
  id Int @id @default(autoincrement())

  name        String  @unique // INSTALL, REMOVE, REPAIR, etc.
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates         Rate[]
  billableItems BillableItem[]
}

model Material {
  id Int @id @default(autoincrement())

  name        String  @unique // tile, wood, drywall, etc.
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates         Rate[]
  billableItems BillableItem[]
}

model Rate {
  id Int @id @default(autoincrement())

  action   Action? @relation(fields: [actionId], references: [id])
  actionId Int?

  material   Material? @relation(fields: [materialId], references: [id])
  materialId Int?

  unitId Int
  unit   MeasurementUnit @relation(fields: [unitId], references: [id])

  context String?

  subAmount    Decimal @db.Decimal(10, 2)
  retailAmount Decimal @db.Decimal(10, 2)
  currency     String  @default("USD")

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  estimatedMinutesPerUnit Int?
  description             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}

enum PricingType {
  SUB
  RETAIL
}

model BillableItem {
  id Int @id @default(autoincrement())

  actionId Int?
  action   Action? @relation(fields: [actionId], references: [id])

  materialId Int?
  material   Material? @relation(fields: [materialId], references: [id])

  unitId Int
  unit   MeasurementUnit @relation(fields: [unitId], references: [id])

  unitPrice   Decimal     @db.Decimal(10, 2) // Dollars (prefilled from Rate, manually overridable)
  pricingType PricingType

  quantity Decimal @db.Decimal(10, 4) // Allow fractional quantities (e.g., 1.5 sqft)
  subtotal Decimal @db.Decimal(10, 2) // Dollars (quantity × unitPrice, calculated server-side)

  estimatedMinutesPerUnit Int?

  notes String?

  // Ordering within an estimate; lower numbers appear first
  sortOrder Int @default(0)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  estimate   Estimate? @relation(fields: [estimateId], references: [id])
  estimateId Int?

  @@index([estimateId, sortOrder])
}

enum EntityType {
  CONTRACTOR
  CLIENT
  RETAILER
  OTHER
}

model Entity {
  id Int @id @default(autoincrement())

  type EntityType

  name        String
  nickname    String?
  contactName String?

  email String?
  phone String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String? @default("US")
  // latitude     Decimal? @db.Decimal(9, 6)
  // longitude    Decimal? @db.Decimal(9, 6)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  usersDefault  User[] @relation("defaultEntity")
  usersRetailer User[] @relation("defaultRetailerEntity")

  // Estimate relations (explicitly named to avoid conflicts)
  estimatesAsInstaller Estimate[] @relation("installerEntity")
  estimatesAsClient    Estimate[] @relation("clientEntity")
  estimatesAsRetailer  Estimate[] @relation("retailerEntity")
  estimates            Estimate[]
  users                User[]

  @@index([authorId])
}

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  UNDERWAY
  INVOICED
  REJECTED
  EXPIRED
}

model Estimate {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  title String?

  status EstimateStatus @default(DRAFT)

  // --- Entity assignments (explicit roles) ---
  installerEntityId Int?
  installerEntity   Entity? @relation("installerEntity", fields: [installerEntityId], references: [id])

  clientEntityId Int?
  clientEntity   Entity? @relation("clientEntity", fields: [clientEntityId], references: [id])

  retailerEntityId Int?
  retailerEntity   Entity? @relation("retailerEntity", fields: [retailerEntityId], references: [id])

  // --- Snapshot job location (do NOT normalize yet) ---
  jobAddressLine1 String?
  jobAddressLine2 String?
  jobCity         String?
  jobState        String?
  jobPostalCode   String?
  jobCountry      String? @default("US")

  subtotal Decimal @db.Decimal(12, 2)
  taxTotal Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  estimatedMinutesTotal Int?

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  // This is the big one, it should have a complex combo dropdown and add/update/remove/reorder/delete UI
  billableItems BillableItem[]

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entity    Entity?  @relation(fields: [entityId], references: [id])
  entityId  Int?

  @@index([authorId])
  @@index([status])
}

